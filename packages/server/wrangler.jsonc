{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opentunnel-shuv",
  "main": "src/index.ts",
  "account_id": "771240435fb4f1407f2b4669085dc79d",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "shuv.zip/api/*",
      "zone_name": "shuv.zip"
    }
  ],
  "vars": {
    "SHUVTUNNEL_DOMAIN": "shuv.zip",
    "ACME_URL": "https://acme.zerossl.com/v2/DV90",
    "ACME_EMAIL": "shuv@shuv.dev",
    "ACME_DNS_PROPAGATION_TIMEOUT_MS": "10000",
    "CLOUDFLARE_ZONE_ID": "c3873d6934c4d42ed652225530ad9cd6"
  },
  "secrets": {
    "required": [
      "ACME_EAB_KID",
      "ACME_EAB_HMAC_KEY",
      "ACME_ACCOUNT_KEY_JWK",
      "CLOUDFLARE_API_TOKEN",
      "RELAY_TOKEN"
    ]
  },
  "alias": {
    "@peculiar/acme-client": "@peculiar/acme-client/build/es2015/index.js"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNELS",
        "class_name": "TunnelObject"
      }
    ]
  },
  "exports": {
    "TunnelObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "workflows": [
    {
      "name": "opentunnel-shuv-certificates",
      "binding": "CERTIFICATES",
      "class_name": "CertificateWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
